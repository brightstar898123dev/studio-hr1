# -----------------------------------------------------------------------------
# HR Recruiting App - environment variables
# Copy this file to .env.local for local development:  cp .env.example .env.local
# On Vercel, add the same names under Project -> Settings -> Environment Variables.
# Never commit real values. Every value below is a safe placeholder.
# -----------------------------------------------------------------------------

# --- App ---------------------------------------------------------------------
# The public address of the app, without a trailing slash.
# Local: http://localhost:3000   Live: https://hr.company.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Time zone used for "today" (daily send limit, digest, dashboard counts).
APP_TIMEZONE=Asia/Kolkata

# --- Supabase ----------------------------------------------------------------
# Local values are printed by `npx supabase start` (or `npx supabase status`).
# Live values: Supabase dashboard -> Project Settings -> API (used for login only).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server only. The app reads and writes data through this connection.
# Live: Supabase dashboard -> Connect -> "Transaction pooler" connection string (port 6543).
# Local Supabase: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Who may log in (comma separated). Strongly recommended: only these emails can use the app,
# even if someone manages to create another Supabase account.
ALLOWED_EMAILS=hr@company.com
# The app applies database migrations automatically when it starts. Set to false to do it by hand (npm run db:migrate).
AUTO_MIGRATE=true

# --- Secrets you make up yourself (long random strings) ----------------------
# Generate one with:  openssl rand -hex 32
# Used by GitHub Actions to call the scheduled jobs. Must match the GitHub secret CRON_SECRET.
CRON_SECRET=replace-with-a-long-random-string
# Part of the Brevo inbound webhook URL: <APP_URL>/api/webhooks/brevo-inbound/<INBOUND_WEBHOOK_SECRET>
INBOUND_WEBHOOK_SECRET=replace-with-another-long-random-string

# --- Brevo (sending email + receiving replies) -------------------------------
# Brevo -> SMTP & API -> API Keys.
BREVO_API_KEY=replace-with-brevo-api-key
# Subdomain whose MX records point to Brevo inbound. Replies go to <token>@REPLY_DOMAIN.
# Can also be set in the Settings page; the Settings page value wins when filled.
REPLY_DOMAIN=reply.company.com
# Only for the Gmail fallback (START_HERE.md, Troubleshooting): a fixed Reply-To used when no reply domain is set.
REPLY_TO_ADDRESS=

# --- OpenRouter (AI) ---------------------------------------------------------
# openrouter.ai -> Keys.
OPENROUTER_API_KEY=replace-with-openrouter-key
# Main model. Free models end with ":free". Check the live list at https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=openai/gpt-oss-120b:free
# Used when the main model fails. "openrouter/free" lets OpenRouter pick any available free model.
OPENROUTER_FALLBACK_MODEL=openrouter/free
# Stop making AI calls after this many requests per day (free tier is about 50/day).
OPENROUTER_DAILY_LIMIT=45

# --- Mock modes (local development and tests) --------------------------------
# true = emails are stored in the app (Outbox "Sent" tab + activity log) instead of being sent.
MOCK_EMAIL=true
# true = AI replies are fake but predictable. No OpenRouter key needed.
MOCK_AI=true
# true = no Supabase at all: a built-in demo database (saved in MOCK_DB_DIR) is used instead.
# Login with MOCK_ADMIN_EMAIL / MOCK_ADMIN_PASSWORD. The app REFUSES to start with this in production.
MOCK_DB=false
# Where demo data is saved. Use "memory" to start empty every time.
MOCK_DB_DIR=./.data/pglite
MOCK_ADMIN_EMAIL=admin@example.com
MOCK_ADMIN_PASSWORD=change-me-locally

# --- Tests only --------------------------------------------------------------
# Optional. A throwaway Postgres for the concurrency tests in tests/db.
# WARNING: those tests wipe the "public" schema of this database. Never point it at real data.
# Leave empty to skip them (all other tests still run).
TEST_DATABASE_URL=
